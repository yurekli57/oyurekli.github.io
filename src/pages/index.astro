---
import Layout from '../layouts/Layout.astro';
import Geometry from '../components/Geometry.astro';
import { profile } from '../data/profile';
import publications from '../data/publications.html?raw';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const recent = publications.slice(publications.indexOf('<h2'), publications.indexOf('<h2 id="year-2014"')); 
const projects = (await getCollection('research')).sort((a,b) => a.data.order-b.data.order);
---
<Layout><section class="hero wrap"><div><p class="eyebrow">{profile.affiliation}</p><h1>{profile.intro}</h1><p class="hero-bio">{profile.bio}</p><a class="button" href={`${base}research/`}>Explore my research ↗</a><a class="text-link hero-contact" href={`mailto:${profile.email}`}>Contact me</a></div><div class="figure"><Geometry/><div class="figure-caption"><span>FIG. 01</span> A study in structure & symmetry</div></div></section>
<section class="interests wrap"><span class="eyebrow">Areas of interest</span><div>{profile.interests.map((interest,i) => <span><small>0{i+1}</small>{interest}</span>)}</div></section>
<section class="section wrap"><div class="section-heading"><div><p class="eyebrow">Questions & connections</p><h2>Research directions</h2></div><a class="text-link" href={`${base}research/`}>All research ↗</a></div><div class="research-grid">{projects.map((p,i) => <a class="research-card" href={`${base}research/${p.id}/`}><span class="card-top">0{i+1}<span>↗</span></span><p class="eyebrow">{p.data.area}</p><h3>{p.data.title}</h3><p>{p.data.description}</p></a>)}</div></section>
<section class="section wrap"><div class="section-heading"><div><p class="eyebrow">Selected work</p><h2>Recent publications</h2></div><a class="text-link" href={`${base}publications/`}>All publications ↗</a></div><div class="publication-citations publication-preview" set:html={recent}/></section>
<section class="contact-band"><div class="wrap"><p class="eyebrow">An open conversation</p><h2>Mathematics grows<br/>through exchange.</h2><p>For research discussions, seminar invitations, or questions about my work.</p><a class="text-link" href={`mailto:${profile.email}`}>{profile.email} ↗</a></div></section></Layout>
