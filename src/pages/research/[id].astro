---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('research')).map(entry => ({ params: { id: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Layout title={entry.data.title} description={entry.data.description}><article class="wrap article"><a class="text-link" href={`${import.meta.env.BASE_URL}research/`}>← Research</a><p class="eyebrow article-label">{entry.data.area}{entry.data.example && ' · Example project'}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><div class="prose"><Content/></div></article></Layout>
